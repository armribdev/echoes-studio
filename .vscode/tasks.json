{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo-check",
      "type": "shell",
      "command": "cargo check --manifest-path=./src-tauri/Cargo.toml",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
