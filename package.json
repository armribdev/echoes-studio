{
	"name": "echoes-studio",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"predev:tauri": "node scripts/check-env.mjs --quiet",
		"tauri:dev": "tauri dev --no-watch",
		"tauri:dev:watch": "tauri dev",
		"prebuild:tauri": "node scripts/check-env.mjs --quiet",
		"tauri:build": "tauri build --config src-tauri/tauri.bundle.conf.json",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --max-warnings 0 && node scripts/check-colors.mjs && node scripts/check-controls.mjs",
		"format": "prettier --write .",
		"check-env": "node scripts/check-env.mjs",
		"clean": "node scripts/clean.mjs",
		"clean:deep": "node scripts/clean.mjs --deep",
		"test": "node scripts/test-all.mjs",
		"test:frontend": "vitest run",
		"test:frontend:watch": "vitest"
	},
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=8.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@tauri-apps/cli": "^2",
		"@types/eslint": "8.56.0",
		"@types/node": "^25.9.1",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"sass": "^1.69.7",
		"svelte": "^4.2.7",
		"svelte-check": "^3.6.0",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.3",
		"vitest": "^2.1.9"
	},
	"type": "module",
	"dependencies": {
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2",
		"@tauri-apps/plugin-updater": "~2.12.0",
		"svelte-i18n": "^4.0.1",
		"wavesurfer.js": "^7.7.1"
	}
}
