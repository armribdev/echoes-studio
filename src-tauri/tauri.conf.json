{
	"$schema": "../node_modules/@tauri-apps/cli/schema.json",
	"productName": "echoes-studio",
	"version": "0.1.0",
	"identifier": "com.echoes-studio.app",
	"build": {
		"beforeBuildCommand": "cargo build --release --manifest-path src-tauri/Cargo.toml -p plugin_host_bridge && pnpm run build",
		"beforeDevCommand": "cargo build --manifest-path src-tauri/Cargo.toml -p plugin_host_bridge && pnpm run dev",
		"devUrl": "http://localhost:5173",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Echoes Studio",
				"width": 1400,
				"height": 900,
				"fullscreen": false,
				"resizable": true,
				"dragDropEnabled": true,
				"theme": "Dark"
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"category": "DeveloperTool",
		"copyright": "",
		"targets": "all",
		"shortDescription": "A radically simple open-source DAW",
		"longDescription": "A radically simple open-source DAW — designed from scratch to get out of your way.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": [],
		"externalBin": [],
		"linux": {
			"deb": {
				"depends": []
			}
		},
		"macOS": {
			"entitlements": null,
			"exceptionDomain": "",
			"frameworks": [],
			"providerShortName": null,
			"signingIdentity": null
		},
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": ""
		}
	}
}
